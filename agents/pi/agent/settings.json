{
  "lastChangelogVersion": "1.0.0",
  "theme": "rosepine-dawn/rosepine-moon",
  "hideThinkingBlock": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol"
  ],
  "quietStartup": "header",
  "collapseChangelog": true,
  "followUpMode": "all",
  "steeringMode": "all",
  "doubleEscapeAction": "none",
  "packages": [
    "npm:pi-web-access@0.35.0",
    {
      "source": "git:github.com/championswimmer/pi-context-usage@v2.1.0",
      "skills": [
        "-.agents/skills/planning/SKILL.md",
        "-.agents/skills/release/SKILL.md"
      ]
    }
  ],
  "extensions": [
    "-extensions/builtin-tool-renderers.ts",
    "-extensions/custom-header.ts"
  ],
  "terminal": {
    "showImages": true
  },
  "showCacheMissNotices": true,
  "editorPaddingX": 0,
  "tuiMode": "fullscreen"
}
