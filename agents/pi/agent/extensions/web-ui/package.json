{
  "name": "pi-web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "nub run format:check && nub run lint && nub run typecheck && nub run test && nub run test:e2e",
    "format": "oxfmt src e2e mock test scripts docs package.json tsconfig.json PLAN.md playwright.config.ts vite.config.mjs README.md",
    "format:check": "oxfmt --check src e2e mock test scripts docs package.json tsconfig.json PLAN.md playwright.config.ts vite.config.mjs README.md",
    "lint": "oxlint --deny-warnings --ignore-pattern 'dist/**' .",
    "mock": "node mock/server.mjs",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "build:check": "node scripts/check-bundle.mjs",
    "preview": "vite build && node mock/server.mjs",
    "test": "nub run build:check && nub run test:deployment",
    "test:deployment": "node scripts/test-clean-install.mjs",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotfiles/pi-web-ui-client": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2",
    "vite": "6.0.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
