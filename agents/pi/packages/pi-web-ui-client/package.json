{
  "name": "@dotfiles/pi-web-ui-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./wire": {
      "types": "./src/wire/index.ts",
      "default": "./src/wire/index.ts"
    },
    "./client": "./src/client/index.tsx",
    "./styles.css": "./src/styles.css",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tsx-loader.mjs --test"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.8",
    "@tanstack/virtual-core": "3.17.6",
    "dompurify": "3.2.6",
    "highlight.js": "11.11.1",
    "marked": "14.1.3",
    "preact": "10.24.3",
    "react": "npm:@preact/compat@18.3.2",
    "react-dom": "npm:@preact/compat@18.3.2",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@types/node": "26.1.1",
    "esbuild": "0.24.2",
    "jsdom": "28.1.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "warn"
    }
  }
}
