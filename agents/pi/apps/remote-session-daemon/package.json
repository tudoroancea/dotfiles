{
  "name": "@dotfiles/remote-session-daemon",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "remote-session-daemon": "./src/cli.ts"
  },
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "node --experimental-strip-types src/cli.ts",
    "build": "vite build --config vite.web.config.mjs",
    "build:watch": "vite build --config vite.web.config.mjs --watch",
    "build:check": "node scripts/check-bundle.mjs",
    "format": "oxfmt package.json tsconfig.json vite.web.config.mjs src test docs scripts",
    "format:check": "oxfmt --check package.json tsconfig.json vite.web.config.mjs src test docs scripts",
    "lint": "oxlint --deny-warnings src test",
    "typecheck": "tsc --noEmit",
    "test": "nub run build:check && vitest run",
    "check": "nub run format:check && nub run lint && nub run typecheck && nub run test"
  },
  "dependencies": {
    "@dotfiles/pi-web-ui-client": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.5.0",
      "onFail": "error"
    }
  }
}
